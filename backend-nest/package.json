{
  "name": "autodm-backend-nest",
  "version": "1.0.0",
  "description": "Instagram Auto-DM SaaS backend (NestJS + Fastify)",
  "scripts": {
    "dev": "node -r ts-node/register src/main.ts",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "node -r ts-node/register src/main.ts",
    "start:worker": "node dist/worker.js",
    "worker:dev": "node -r ts-node/register src/worker.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "check:render-config": "node scripts/check-render-config.cjs",
    "admin:bootstrap-super-admin": "node scripts/bootstrap-super-admin.cjs",
    "test:admin-bootstrap-policy": "node scripts/bootstrap-super-admin-policy-check.cjs",
    "test": "jest",
    "test:redis-throttler": "node scripts/redis-throttler-smoke.cjs",
    "test:dashboard-events-smoke": "node scripts/dashboard-events-smoke.cjs",
    "test:webhook-intake-smoke": "node scripts/webhook-intake-smoke.cjs",
    "test:smoke": "node scripts/auth-smoke.cjs",
    "test:audit-immutability": "node scripts/audit-immutability-smoke.cjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.9",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/common": "^11.2.11",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.11",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-fastify": "^11.2.11",
    "@nestjs/schedule": "^5.0.1",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/throttler": "^6.3.0",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.10",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.1.1",
    "cloudinary": "^2.11.0",
    "crypto-js": "^4.2.0",
    "fastify": "^5.12.8",
    "ioredis": "^5.3.2",
    "nodemailer": "^10.6.0",
    "pg": "^8.23.1",
    "prisma": "^6.19.2",
    "razorpay": "^2.9.8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5",
    "typescript": "^5.7.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.11",
    "@types/bcryptjs": "^2.4.6",
    "@types/crypto-js": "^4.2.2",
    "@types/nodemailer": "^6.4.17",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "tmp": "^0.2.6",
    "picomatch": "^4.0.4",
    "glob": "^14.0.2",
    "minimatch": "^11.0.1",
    "deepmerge-ts": "^8.0.2",
    "effect": "^3.22.5"
  }
}
