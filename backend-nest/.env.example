# ───── Database (Neon) ─────
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/neondb?sslmode=verify-full&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=verify-full"

# ───── Redis (Upstash) ─────
REDIS_URL="rediss://default:PASSWORD@HOST.upstash.io:6379"

# ───── Auth secrets (generate: openssl rand -hex 32) ─────
JWT_ACCESS_SECRET="change-me-32-chars-min"
JWT_REFRESH_SECRET="change-me-32-chars-min"
ENCRYPTION_KEY="change-me-32-chars-min"

# ───── Meta / Instagram ─────
META_APP_ID=""
META_APP_SECRET=""
META_WEBHOOK_VERIFY_TOKEN="change-me"
META_GRAPH_VERSION="v26.0"
# Meta API calls bypass inherited HTTP_PROXY/HTTPS_PROXY by default. Set this
# only when the hosting network requires an explicit outbound proxy.
META_HTTPS_PROXY=""
# Enable only after Meta configuration, HTTPS callback, webhook, and permissions are verified.
META_UNIFIED_LOGIN_ENABLED="false"
META_UNIFIED_LOGIN_CONFIG_ID="" # Facebook Login for Business config_id; not a secret

# Optional Cloudinary server-side credentials for profile avatar uploads.
# Keep API secret in backend secrets only; leave all three blank to disable uploads.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_AVATAR_FOLDER="heylaunch/avatars"

# ───── Razorpay ─────
RAZORPAY_KEY_ID="rzp_test_xxx"
RAZORPAY_KEY_SECRET="xxx"
RAZORPAY_WEBHOOK_SECRET="configure-in-Razorpay-dashboard"

# ───── Email (Brevo SMTP) ─────
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="HeyLaunch <no-reply@heylaunch.app>"
SUPPORT_NOTIFICATION_EMAIL="" # optional operations inbox for support/feedback submissions and customer replies

# ───── App URLs ─────
PORT=4000
NODE_ENV=production
# Set true only for a controlled development run; production schedules are always enabled.
# RUN_SCHEDULED_JOBS_IN_DEVELOPMENT=false
# Delivery workers can send Instagram DMs. Keep disabled during ordinary local work.
# Enable only with an authorized test account and a known-safe, isolated development queue.
# RUN_DELIVERY_WORKER_IN_DEVELOPMENT=false
# RUN_MAIL_OUTBOX_WORKER_IN_DEVELOPMENT=false
LEGAL_POLICY_STATUS=DRAFT # switch to APPROVED only after owner/legal review and policy-version updates
COOKIE_SECURE=true
WEBHOOK_PAYLOAD_RETENTION_DAYS=30
UNVERIFIED_ACCOUNT_RETENTION_DAYS=30
PUBLIC_URL="https://relayo-api.onrender.com"       # backend's own public URL (for IG OAuth callback)
CORS_ORIGIN="https://relayo-frontend.onrender.com" # frontend origin allowed to call the API
