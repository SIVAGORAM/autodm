# ───── Database (Neon) ─────
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/neondb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require"

# ───── Redis (Upstash) ─────
REDIS_URL="rediss://default:PASSWORD@HOST.upstash.io:6379"

# ───── Auth secrets (generate: openssl rand -hex 32) ─────
JWT_ACCESS_SECRET="change-me-32-chars-min"
JWT_REFRESH_SECRET="change-me-32-chars-min"
ENCRYPTION_KEY="change-me-32-chars-min"

# ───── Meta / Instagram ─────
META_APP_ID=""
META_APP_SECRET=""
META_WEBHOOK_VERIFY_TOKEN="change-me"
META_GRAPH_VERSION="v21.0"

# ───── Razorpay ─────
RAZORPAY_KEY_ID="rzp_test_xxx"
RAZORPAY_KEY_SECRET="xxx"

# ───── Email (Brevo SMTP) ─────
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Relayo <no-reply@relayo.app>"

# ───── App URLs ─────
PORT=4000
NODE_ENV=production
COOKIE_SECURE=true
PUBLIC_URL="https://relayo-api.onrender.com"       # backend's own public URL (for IG OAuth callback)
CORS_ORIGIN="https://relayo-frontend.onrender.com" # frontend origin allowed to call the API
