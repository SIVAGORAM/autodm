// Auto-DM SaaS — NestJS backend schema
// Extends the original model with richer triggers, buttons, follow-ups,
// contacts, runs and click tracking (from replica/recon.md).
generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────── Accounts & auth ───────────────────────────
model User {
  id                         String    @id @default(uuid())
  email                      String    @unique
  passwordHash               String
  name                       String
  profilePicUrl              String?
  role                       UserRole  @default(INFLUENCER)
  adminPermissions           String[]  @default([])
  sessionVersion             Int       @default(0)
  adminMfaEnabledAt          DateTime?
  adminMfaSecretEnc          String?
  adminMfaPendingSecretEnc   String?
  adminMfaRecoveryCodeHashes String[]  @default([])
  adminMfaChallengeHash      String?
  adminMfaChallengeExpiresAt DateTime?
  adminMfaLastUsedStep       BigInt?
  isVerified                 Boolean   @default(false)
  otpCode                    String?
  otpExpires                 DateTime?
  otpAttempts                Int       @default(0)
  passwordResetTokenHash     String?
  passwordResetExpiresAt     DateTime?
  termsVersion               String?
  termsAcceptedAt            DateTime?
  privacyVersion             String?
  privacyAcknowledgedAt      DateTime?
  ageConfirmedAt             DateTime?
  plan                       PlanTier  @default(FREE)
  planExpiresAt              DateTime?
  trialEndsAt                DateTime?
  trialReminderSent          Boolean   @default(false)
  deletionRequestedAt        DateTime?
  suspendedAt                DateTime?
  suspensionReason           String?
  dmCount                    Int       @default(0) // DMs triggered in the current quota window
  dmCountResetAt             DateTime? // when dmCount rolls back to 0 (start of next month)
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  igAccounts                     IgAccount[]
  refreshTokens                  RefreshToken[]
  payments                       Payment[]
  mailOutbox                     MailOutbox[]
  supportRequests                SupportRequest[]
  supportMessages                SupportMessage[]
  adminAuditEvents               AdminAuditEvent[]
  assignedContactEnquiries       ContactEnquiry[]        @relation("ContactEnquiryAssignee")
  authoredContactEnquiryMessages ContactEnquiryMessage[] @relation("ContactEnquiryAdminAuthor")
  sentAdminInvitations           AdminInvitation[]       @relation("AdminInvitationInviter")
  acceptedAdminInvitations       AdminInvitation[]       @relation("AdminInvitationAcceptedBy")
  publicProfile                  PublicProfile?
  reviewedPublicProfileReports   PublicProfileReport[]   @relation("PublicProfileReportReviewer")

  @@index([trialEndsAt]) // speeds the trial-reminder sweep
  @@index([deletionRequestedAt])
  @@index([suspendedAt, createdAt])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  familyId  String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([userId, familyId])
  @@index([userId])
  @@map("refresh_tokens")
}

model Payment {
  id        String   @id @default(uuid())
  orderId   String   @unique
  paymentId String   @unique
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  plan      PlanTier
  amount    Int
  currency  String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("payments")
}

model MetaDataDeletionRequest {
  id               String   @id @default(uuid())
  requestHash      String   @unique
  confirmationCode String   @unique
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@map("meta_data_deletion_requests")
}

model MetaDeauthorizationReceipt {
  id          String   @id @default(uuid())
  requestHash String   @unique
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@map("meta_deauthorization_receipts")
}

// Up to 5 per user (paid). Free = 1.
model IgAccount {
  id                  String             @id @default(uuid())
  userId              String
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  igUserId            String             @unique
  username            String
  loginMode           InstagramLoginMode @default(INSTAGRAM_LOGIN)
  clientBusinessId    String?
  unifiedConfigId     String?
  pageId              String? // Facebook Page id, for Messenger
  accessTokenEnc      String // AES-256 encrypted
  tokenExpiresAt      DateTime?
  webhookSubscribedAt DateTime?
  webhookFields       String[]           @default([])
  isActive            Boolean            @default(true)
  lastAlertAt         DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  automations   Automation[]
  contacts      Contact[]
  runs          Run[]
  webhookEvents WebhookEvent[]

  @@index([userId])
  @@map("ig_accounts")
}

// ─────────────────────────── Automations ───────────────────────────
model Automation {
  id                String           @id @default(uuid())
  igAccountId       String
  igAccount         IgAccount        @relation(fields: [igAccountId], references: [id], onDelete: Cascade)
  name              String
  triggerType       TriggerType
  mediaId           String? // specific post/reel/story; null for any/next
  matchMode         MatchMode        @default(KEYWORDS)
  keywords          String[]         @default([])
  publicReplies     String[]         @default([]) // up to 3, rotated
  replyToComment    Boolean          @default(false)
  autoLikeComment   Boolean          @default(false)
  askToFollow       Boolean          @default(false)
  collectEmail      Boolean          @default(false)
  trackClicks       Boolean          @default(true)
  dmBlocks          Json // ordered message blocks (text/image/video/buttons/card)
  status            AutomationStatus @default(DRAFT)
  language          AutomationLanguage @default(ENGLISH)
  dailyLimit        Int              @default(200)
  dailyCount        Int              @default(0)
  dailyCountResetAt DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  followUps    FollowUp[]
  runs         Run[]
  trackedLinks TrackedLink[]

  @@index([igAccountId])
  @@index([triggerType, status])
  @@map("automations")
}

model FollowUp {
  id           String     @id @default(uuid())
  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  order        Int
  condition    FollowCond
  delayMinutes Int        @default(0)
  dmBlocks     Json

  @@index([automationId])
  @@map("follow_ups")
}

// ─────────────────────────── People & activity ───────────────────────────
model Contact {
  id               String    @id @default(uuid())
  igAccountId      String
  igAccount        IgAccount @relation(fields: [igAccountId], references: [id], onDelete: Cascade)
  igScopedId       String // IGSID of the commenter/sender
  username         String?
  name             String?
  email            String?
  notes            String    @default("")
  tags             String[]  @default([])
  follows          Boolean   @default(false)
  dmsSent          Int       @default(0)
  firstInteraction DateTime  @default(now())
  lastInteraction  DateTime  @default(now())
  lastReplyAt      DateTime?

  runs Run[]

  @@unique([igAccountId, igScopedId])
  @@index([igAccountId])
  @@map("contacts")
}

model Run {
  id                     String     @id @default(uuid())
  automationId           String
  automation             Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  igAccountId            String
  igAccount              IgAccount  @relation(fields: [igAccountId], references: [id], onDelete: Cascade)
  contactId              String?
  contact                Contact?   @relation(fields: [contactId], references: [id])
  triggerEventId         String     @unique // IG comment/message id — idempotency key
  followUpOrder          Int? // snapshot of the follow-up step for customer run history
  status                 RunStatus  @default(PENDING)
  error                  String?
  publicReplyAttemptedAt DateTime?
  publicReplyError       String?
  createdAt              DateTime   @default(now())
  sentAt                 DateTime?

  @@index([automationId])
  @@index([igAccountId, createdAt])
  @@map("runs")
}

model TrackedLink {
  id           String     @id @default(uuid())
  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  slug         String     @unique
  targetUrl    String
  clicks       Int        @default(0)
  createdAt    DateTime   @default(now())

  clickEvents Click[]

  @@index([automationId])
  @@map("tracked_links")
}

model Click {
  id            String      @id @default(uuid())
  trackedLinkId String
  trackedLink   TrackedLink @relation(fields: [trackedLinkId], references: [id], onDelete: Cascade)
  contactIgsid  String?
  clickedAt     DateTime    @default(now())

  @@index([trackedLinkId])
  @@map("clicks")
}

// Processed webhook ids, for cross-process idempotency safety net.
model WebhookEvent {
  id              String     @id @default(uuid())
  eventId         String     @unique
  igUserId        String?
  igAccountId     String?
  igAccount       IgAccount? @relation(fields: [igAccountId], references: [id], onDelete: Cascade)
  payload         Json?
  attempts        Int        @default(0)
  lastError       String?
  nextAttemptAt   DateTime?
  deadLetterAt    DateTime?
  redriveCount    Int        @default(0)
  lastRedrivenAt  DateTime?
  lastRedrivenBy  String?
  payloadPurgedAt DateTime?
  processedAt     DateTime?
  createdAt       DateTime   @default(now())

  @@index([processedAt, createdAt])
  @@index([igUserId, createdAt])
  @@index([deadLetterAt, createdAt])
  @@map("webhook_events")
}

model DmQuotaReservation {
  id                String                   @id @default(uuid())
  triggerEventId    String                   @unique
  userId            String
  automationId      String
  status            DmQuotaReservationStatus @default(CONSUMED)
  monthWindowEndsAt DateTime?
  dayWindowEndsAt   DateTime?
  settledAt         DateTime?
  createdAt         DateTime                 @default(now())

  @@index([userId, createdAt])
  @@index([automationId, createdAt])
  @@map("dm_quota_reservations")
}

// Authentication and lifecycle email content is encrypted at rest and expires
// with the action it represents (OTP/reset token or welcome window).
model MailOutbox {
  id                      String                 @id @default(uuid())
  userId                  String?
  user                    User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  contactEnquiryMessageId String?                @unique
  contactEnquiryMessage   ContactEnquiryMessage? @relation(fields: [contactEnquiryMessageId], references: [id], onDelete: SetNull)
  dedupeKey               String                 @unique
  payloadEnc              String
  status                  String                 @default("PENDING")
  attempts                Int                    @default(0)
  nextAttemptAt           DateTime               @default(now())
  lockedAt                DateTime?
  expiresAt               DateTime
  sentAt                  DateTime?
  failedAt                DateTime?
  lastError               String?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  @@index([status, nextAttemptAt])
  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@map("mail_outbox")
}

model SupportRequest {
  id        String               @id @default(uuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      SupportRequestType
  status    SupportRequestStatus @default(OPEN)
  subject   String
  rating    Int?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  messages  SupportMessage[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("support_requests")
}

model SupportMessage {
  id         String               @id @default(uuid())
  requestId  String
  request    SupportRequest       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?                @relation(fields: [authorId], references: [id], onDelete: SetNull)
  senderType SupportMessageSender
  body       String
  createdAt  DateTime             @default(now())

  @@index([requestId, createdAt])
  @@index([authorId, createdAt])
  @@map("support_messages")
}

model ContactEnquiry {
  id              String                  @id @default(uuid())
  name            String
  email           String
  subject         String
  status          ContactEnquiryStatus    @default(NEW)
  priority        ContactEnquiryPriority  @default(NORMAL)
  assignedAdminId String?
  assignedAdmin   User?                   @relation("ContactEnquiryAssignee", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  messages        ContactEnquiryMessage[]

  @@index([status, priority, updatedAt])
  @@index([assignedAdminId, status, updatedAt])
  @@index([email, createdAt])
  @@map("contact_enquiries")
}

model ContactEnquiryMessage {
  id                  String                     @id @default(uuid())
  enquiryId           String
  enquiry             ContactEnquiry             @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  authorAdminId       String?
  authorAdmin         User?                      @relation("ContactEnquiryAdminAuthor", fields: [authorAdminId], references: [id], onDelete: SetNull)
  kind                ContactEnquiryMessageKind
  body                String
  emailDeliveryStatus ContactEmailDeliveryStatus @default(NOT_APPLICABLE)
  createdAt           DateTime                   @default(now())
  mailOutbox          MailOutbox?

  @@index([enquiryId, createdAt, id])
  @@index([authorAdminId, createdAt])
  @@map("contact_enquiry_messages")
}

// Append-only from application code: stores metadata for privileged actions,
// never authentication secrets or customer message bodies.
model AdminAuditEvent {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String
  targetId   String?
  reason     String
  requestId  String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([createdAt, id])
  @@index([actorId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@map("admin_audit_events")
}

model AdminInvitation {
  id           String    @id @default(uuid())
  email        String
  permissions  String[]  @default([])
  tokenHash    String    @unique
  invitedById  String
  invitedBy    User      @relation("AdminInvitationInviter", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedById String?
  acceptedBy   User?     @relation("AdminInvitationAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  acceptedAt   DateTime?
  revokedAt    DateTime?

  @@index([email, acceptedAt, revokedAt, expiresAt])
  @@index([invitedById, createdAt])
  @@map("admin_invitations")
}

model PublicProfile {
  id                  String                  @id @default(uuid())
  userId              String                  @unique
  user                User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentHandleId     String?                 @unique
  currentHandle       ProfileHandle?          @relation("CurrentProfileHandle", fields: [currentHandleId], references: [id], onDelete: SetNull)
  handles             ProfileHandle[]         @relation("ProfileHandleOwner")
  displayName         String                  @db.VarChar(80)
  bio                 String?                 @db.VarChar(160)
  avatarAssetId       String?
  avatarDeliveryUrl   String?                 @db.Text
  visibility          PublicProfileVisibility @default(PRIVATE)
  moderationBlockedAt DateTime?
  appearance          ProfileAppearance       @default(NEUTRAL)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  links               ProfileLink[]
  reports             PublicProfileReport[]

  @@index([visibility, updatedAt])
  @@map("public_profiles")
}

model ProfileHandle {
  id         String         @id @default(uuid())
  profileId  String
  profile    PublicProfile  @relation("ProfileHandleOwner", fields: [profileId], references: [id], onDelete: Cascade)
  username   String         @db.VarChar(30)
  isCurrent  Boolean        @default(true)
  createdAt  DateTime       @default(now())
  retiredAt  DateTime?
  currentFor PublicProfile? @relation("CurrentProfileHandle")

  @@index([profileId, isCurrent])
  @@map("profile_handles")
}

model ProfileLink {
  id          String          @id @default(uuid())
  profileId   String
  profile     PublicProfile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  kind        ProfileLinkKind
  platform    String?         @db.VarChar(24)
  title       String          @db.VarChar(80)
  url         String          @db.VarChar(2048)
  description String?         @db.VarChar(200)
  sortOrder   Int             @default(0)
  isVisible   Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([profileId, kind, sortOrder])
  @@map("profile_links")
}

model ProfileAssetDeletion {
  id            String   @id @default(uuid())
  assetId       String   @unique
  attempts      Int      @default(0)
  nextAttemptAt DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([nextAttemptAt, createdAt])
  @@map("profile_asset_deletions")
}

model PublicProfileReport {
  id                  String                    @id @default(uuid())
  // Nullable so reports remain in the moderation audit trail if the creator
  // deletes their account and the profile is removed.
  profileId           String?
  profile             PublicProfile?            @relation(fields: [profileId], references: [id], onDelete: SetNull)
  reportedUsername    String                    @db.VarChar(30)
  reportedDisplayName String                    @db.VarChar(80)
  reason              PublicProfileReportReason
  details             String?                   @db.VarChar(1000)
  status              PublicProfileReportStatus @default(OPEN)
  reviewedById        String?
  reviewedBy          User?                     @relation("PublicProfileReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  moderationNote      String?                   @db.VarChar(1000)
  reviewedAt          DateTime?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@index([status, createdAt, id])
  @@index([profileId, createdAt])
  @@map("public_profile_reports")
}

// ─────────────────────────── Enums ───────────────────────────
enum UserRole {
  INFLUENCER
  ADMIN
  SUPER_ADMIN
}

enum InstagramLoginMode {
  INSTAGRAM_LOGIN
  UNIFIED_LOGIN
}

enum PlanTier {
  FREE
  CREATOR
  PRO
  AGENCY
  PAID // legacy (old binary model) — resolved as PRO at runtime
}

enum TriggerType {
  POST_COMMENT // specific post/reel
  NEXT_POST
  ANY_POST
  STORY_REPLY
  STORY_MENTION // when a fan mentions @creator in their story
  LIVE_COMMENT
  DM
}

enum MatchMode {
  KEYWORDS
  ANY
  AI_INTENT
}

enum AutomationStatus {
  DRAFT
  LIVE
  PAUSED
}

enum AutomationLanguage {
  ENGLISH
  TENGLISH
  TELUGU_ENGLISH
}

enum FollowCond {
  DELAY
  LINK_NOT_CLICKED
  NO_REPLY
  BOUGHT
  NOT_BOUGHT
  FORM_NOT_SUBMITTED
}

enum RunStatus {
  PENDING
  SENT
  SKIPPED
  FAILED
  UNKNOWN
}

enum DmQuotaReservationStatus {
  RESERVED
  CONSUMED
  RELEASED
}

enum SupportRequestType {
  SUPPORT
  FEEDBACK
}

enum SupportRequestStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum SupportMessageSender {
  CUSTOMER
  ADMIN
}

enum ContactEnquiryStatus {
  NEW
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  RESOLVED
  CLOSED
  SPAM
}

enum ContactEnquiryPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ContactEnquiryMessageKind {
  SUBMISSION
  ADMIN_REPLY
  INTERNAL_NOTE
}

enum ContactEmailDeliveryStatus {
  NOT_APPLICABLE
  QUEUED
  SENT
  FAILED
  CANCELLED
}

enum PublicProfileVisibility {
  PRIVATE
  PUBLIC
}

enum ProfileAppearance {
  LIGHT
  DARK
  NEUTRAL
}

enum ProfileLinkKind {
  SOCIAL
  CUSTOM
}

enum PublicProfileReportReason {
  IMPERSONATION
  SCAM
  INAPPROPRIATE
  SPAM
  COPYRIGHT
  OTHER
}

enum PublicProfileReportStatus {
  OPEN
  IN_REVIEW
  ACTIONED
  DISMISSED
}
