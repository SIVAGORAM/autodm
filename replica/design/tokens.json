{
  "$comment": "AutoDM design system — original, clean-room. Same shadcn/HSL token structure as the existing frontend so it drops in with no refactor. Swap brand hue here once the brand name is chosen.",
  "color": {
    "light": {
      "background": "0 0% 100%",
      "foreground": "200 24% 12%",
      "card": "0 0% 100%",
      "card-foreground": "200 24% 12%",
      "popover": "0 0% 100%",
      "popover-foreground": "200 24% 12%",
      "primary": "178 70% 30%",
      "primary-foreground": "0 0% 100%",
      "secondary": "196 30% 95%",
      "secondary-foreground": "200 24% 18%",
      "muted": "200 20% 96%",
      "muted-foreground": "200 12% 42%",
      "accent": "14 90% 58%",
      "accent-foreground": "0 0% 100%",
      "success": "152 58% 36%",
      "success-foreground": "0 0% 100%",
      "warning": "38 92% 48%",
      "warning-foreground": "0 0% 100%",
      "destructive": "0 72% 51%",
      "destructive-foreground": "0 0% 100%",
      "border": "200 18% 90%",
      "input": "200 18% 90%",
      "ring": "178 70% 34%"
    },
    "dark": {
      "background": "200 28% 8%",
      "foreground": "190 20% 92%",
      "card": "200 24% 11%",
      "card-foreground": "190 20% 92%",
      "popover": "200 24% 11%",
      "popover-foreground": "190 20% 92%",
      "primary": "172 62% 45%",
      "primary-foreground": "200 28% 8%",
      "secondary": "200 20% 18%",
      "secondary-foreground": "190 20% 92%",
      "muted": "200 18% 18%",
      "muted-foreground": "195 12% 62%",
      "accent": "14 85% 62%",
      "accent-foreground": "200 28% 8%",
      "success": "152 52% 46%",
      "success-foreground": "200 28% 8%",
      "warning": "38 88% 56%",
      "warning-foreground": "200 28% 8%",
      "destructive": "0 65% 55%",
      "destructive-foreground": "0 0% 100%",
      "border": "200 16% 20%",
      "input": "200 16% 20%",
      "ring": "172 62% 45%"
    },
    "chart": {
      "$comment": "Categorical series for the analytics screen. Accessible, distinct hues. Confirm with the dataviz skill when the charts are built.",
      "1": "178 70% 34%",
      "2": "14 90% 58%",
      "3": "243 60% 60%",
      "4": "38 92% 48%",
      "5": "280 55% 58%",
      "6": "200 16% 46%"
    }
  },
  "radius": { "base": "0.625rem", "sm": "calc(var(--radius) - 4px)", "md": "calc(var(--radius) - 2px)", "lg": "var(--radius)", "xl": "calc(var(--radius) + 4px)", "pill": "9999px" },
  "typography": {
    "fontFamily": { "sans": "Inter, ui-sans-serif, system-ui, sans-serif", "mono": "ui-monospace, SFMono-Regular, Menlo, monospace" },
    "scale": {
      "xs": ["0.75rem", "1rem"],
      "sm": ["0.875rem", "1.25rem"],
      "base": ["1rem", "1.5rem"],
      "lg": ["1.125rem", "1.75rem"],
      "xl": ["1.25rem", "1.75rem"],
      "2xl": ["1.5rem", "2rem"],
      "3xl": ["1.875rem", "2.25rem"],
      "4xl": ["2.25rem", "2.5rem"]
    },
    "weight": { "normal": 400, "medium": 500, "semibold": 600, "bold": 700 }
  },
  "spacing": { "$comment": "4px base. Tailwind defaults already match; listed for the design record.", "1": "0.25rem", "2": "0.5rem", "3": "0.75rem", "4": "1rem", "6": "1.5rem", "8": "2rem", "12": "3rem", "16": "4rem" },
  "shadow": {
    "sm": "0 1px 2px 0 hsl(200 24% 12% / 0.05)",
    "md": "0 2px 8px -2px hsl(200 24% 12% / 0.10)",
    "lg": "0 8px 24px -6px hsl(200 24% 12% / 0.14)",
    "focus": "0 0 0 3px hsl(178 70% 34% / 0.35)"
  },
  "motion": { "fast": "120ms", "base": "180ms", "slow": "260ms", "ease": "cubic-bezier(0.4, 0, 0.2, 1)" }
}
