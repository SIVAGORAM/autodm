// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  passwordHash   String
  name           String
  profilePicUrl  String?
  role           UserRole  @default(INFLUENCER)
  isVerified     Boolean   @default(false)
  otpCode        String?
  otpExpires     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  instagramAccount InstagramAccount?
  subscription     Subscription?
  payments         Payment[]
  refreshTokens    RefreshToken[]
  notifications    Notification[]
  feedbacks        Feedback[]
  supportTickets   SupportTicket[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model InstagramAccount {
  id               String    @id @default(uuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  instagramUserId  String    @unique
  username         String
  accessTokenEnc   String    // AES-256 encrypted
  tokenExpiresAt   DateTime?
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  campaigns    Campaign[]
  posts        Post[]
  dmLogs       DmLog[]

  @@map("instagram_accounts")
}

model Campaign {
  id                   String          @id @default(uuid())
  instagramAccountId   String
  instagramAccount     InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  name                 String
  status               CampaignStatus  @default(ACTIVE)
  requireFollower      Boolean         @default(true)
  messageTemplate      String
  keywords             String[]        @default([])
  dailyLimit           Int             @default(200)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  posts          Post[]
  automationRules AutomationRule[]
  commentEvents   CommentEvent[]

  @@index([instagramAccountId])
  @@map("campaigns")
}

model Post {
  id                   String          @id @default(uuid())
  instagramAccountId   String
  instagramAccount     InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  campaignId           String?
  campaign             Campaign?       @relation(fields: [campaignId], references: [id])
  instagramPostId      String          @unique
  mediaType            String          // IMAGE | VIDEO | CAROUSEL_ALBUM
  caption              String?
  permalink            String?
  isActive             Boolean         @default(true)
  createdAt            DateTime        @default(now())

  commentEvents CommentEvent[]

  @@index([instagramAccountId])
  @@map("posts")
}

model AutomationRule {
  id          String   @id @default(uuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  triggerWord String?  // null = trigger on any comment
  message     String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([campaignId])
  @@map("automation_rules")
}

model CommentEvent {
  id                String        @id @default(uuid())
  campaignId        String
  campaign          Campaign      @relation(fields: [campaignId], references: [id])
  postId            String
  post              Post          @relation(fields: [postId], references: [id])
  instagramCommentId String       @unique  // idempotency key
  commentorId       String
  commentorUsername String
  commentText       String
  processedAt       DateTime?
  status            EventStatus   @default(PENDING)
  createdAt         DateTime      @default(now())

  dmLog DmLog?

  @@index([campaignId])
  @@index([instagramCommentId])
  @@map("comment_events")
}

model DmLog {
  id                 String        @id @default(uuid())
  instagramAccountId String
  instagramAccount   InstagramAccount @relation(fields: [instagramAccountId], references: [id])
  commentEventId     String        @unique
  commentEvent       CommentEvent  @relation(fields: [commentEventId], references: [id])
  recipientId        String
  recipientUsername  String
  message            String
  status             DmStatus      @default(SENT)
  errorMessage       String?
  sentAt             DateTime      @default(now())
  deliveredAt        DateTime?

  @@index([instagramAccountId])
  @@index([sentAt])
  @@map("dm_logs")
}

model FollowerCache {
  id                  String   @id @default(uuid())
  instagramAccountId  String
  followerId          String
  isFollower          Boolean
  cachedAt            DateTime @default(now())
  expiresAt           DateTime

  @@unique([instagramAccountId, followerId])
  @@index([expiresAt])
  @@map("follower_cache")
}

model Plan {
  id            String   @id @default(uuid())
  name          String   @unique
  razorpayPlanId String  @unique
  price         Int      // in paise
  interval      String   // monthly | yearly
  campaignLimit Int
  dmLimit       Int
  features      String[]
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                   String             @id @default(uuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id])
  planId               String
  plan                 Plan               @relation(fields: [planId], references: [id])
  razorpaySubId        String             @unique
  status               SubscriptionStatus @default(CREATED)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@map("subscriptions")
}

model Payment {
  id                 String        @id @default(uuid())
  userId             String
  user               User          @relation(fields: [userId], references: [id])
  razorpayPaymentId  String        @unique
  razorpayOrderId    String?
  amount             Int
  currency           String        @default("INR")
  status             PaymentStatus @default(PENDING)
  createdAt          DateTime      @default(now())

  @@index([userId])
  @@map("payments")
}

model RazorpayEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique
  eventType   String
  payload     Json
  processedAt DateTime @default(now())

  @@map("razorpay_events")
}

enum UserRole {
  INFLUENCER
  ADMIN
}

enum CampaignStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

enum EventStatus {
  PENDING
  PROCESSING
  DM_SENT
  SKIPPED
  FAILED
}

enum DmStatus {
  SENT
  DELIVERED
  FAILED
}

enum SubscriptionStatus {
  CREATED
  AUTHENTICATED
  ACTIVE
  HALTED
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String
  category    String   // success | security | updates | billing
  actionLabel String?
  actionUrl   String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId])
  @@map("notifications")
}

model Feedback {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    String   // Poor, Bad, Okay, Good, Amazing
  category  String
  urgency   String
  message   String
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("feedbacks")
}

model SupportTicket {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject     String
  description String
  status      String   @default("OPEN") // OPEN, RESOLVED, CLOSED
  createdAt   DateTime @default(now())

  @@index([userId])
  @@map("support_tickets")
}
