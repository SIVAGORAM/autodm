# Database (Neon DB - free tier)
DATABASE_URL="postgresql://user:pass@ep-xxx.neon.tech/instagram_automation?sslmode=require"
DIRECT_URL="postgresql://user:pass@ep-xxx.neon.tech/instagram_automation?sslmode=require"

# Redis (Upstash - free tier)
UPSTASH_REDIS_URL="rediss://default:password@global-xxx.upstash.io:6379"

# JWT secrets (generate with: openssl rand -base64 64)
JWT_ACCESS_SECRET="your-access-secret-min-64-chars"
JWT_REFRESH_SECRET="your-refresh-secret-min-64-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# AES encryption key for Instagram tokens (32 bytes hex)
ENCRYPTION_KEY="your-32-byte-hex-encryption-key"

# Instagram Graph API
INSTAGRAM_APP_ID="your-instagram-app-id"
INSTAGRAM_APP_SECRET="your-instagram-app-secret"
INSTAGRAM_WEBHOOK_VERIFY_TOKEN="your-webhook-verify-token"

# Razorpay
RAZORPAY_KEY_ID="rzp_live_xxx"
RAZORPAY_KEY_SECRET="your-razorpay-secret"
RAZORPAY_WEBHOOK_SECRET="your-webhook-secret"

# Server
PORT=4000
NODE_ENV=production
CORS_ORIGIN="https://yourdomain.com"

# Cookie settings
COOKIE_DOMAIN=".yourdomain.com"
COOKIE_SECURE=true

# Admin
ADMIN_EMAIL="admin@yourdomain.com"
